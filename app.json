{
  "expo": {
    "name": "ልክ pay",
    "slug": "receipt-verify-ethiopia",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/473cc043-9a62-40e2-85a2-6f5602afcc0b",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "receiptverify",
    "android": {
      "package": "et.andualem.receiptverify",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ልክ pay to take receipt photos and scan QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ልክ pay to read receipt screenshots."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ልክ pay to access your photos.",
          "savePhotosPermission": "Allow ልክ pay to save receipt photos."
        }
      ],
      "expo-font",
      "./plugins/withMLKit"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "473cc043-9a62-40e2-85a2-6f5602afcc0b"
      }
    }
  }
}
